<?xml version="1.0" encoding="utf-8"?>
<!--
  分组容器的「尾」：组级动作（左）+ 展开/收起（右），并负责给这张卡收底。
  只在真的需要时才作为一行插进列表（有动作 / 该组被折叠 / 条目过多），
  否则条目自己用 bg_group_row_last 收底，不浪费一行高度。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_group_footer"
    android:orientation="vertical">

    <View
        android:id="@+id/vFooterDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="42dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tvGroupAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:drawablePadding="5dp"
            android:focusable="true"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="@color/brand_dark"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_copy"
            app:drawableTint="@color/brand_dark"
            tools:text="复制全部取件码"
            tools:visibility="visible" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvFold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="6dp"
            android:paddingBottom="8dp"
            android:textColor="@color/text_sub"
            android:textSize="12sp"
            tools:text="展开全部 42 件" />
    </LinearLayout>
</LinearLayout>
