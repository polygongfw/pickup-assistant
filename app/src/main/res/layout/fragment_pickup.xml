<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipe"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="待取件"
                android:textAppearance="@style/TextAppearance.PickupAssistant.Title" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                tools:text="09月30日 星期二" />

            <!-- 概览卡 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHeader"
                style="@style/Widget.PickupAssistant.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvPendingCount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/text"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            tools:text="3 件待取" />

                        <TextView
                            android:id="@+id/tvClosing"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_warn"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:textColor="@color/warn"
                            android:textSize="12sp"
                            android:visibility="gone"
                            tools:text="还有 1 小时打烊" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowStation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_location"
                            app:tint="@color/brand" />

                        <TextView
                            android:id="@+id/tvStation"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:textColor="@color/text"
                            android:textSize="14sp"
                            tools:text="示例小区东门菜鸟驿站" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowOffice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_clock"
                            app:tint="@color/text_muted" />

                        <TextView
                            android:id="@+id/tvOffice"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:textColor="@color/text_sub"
                            android:textSize="13sp"
                            tools:text="营业时间 09:00-22:30" />
                    </LinearLayout>

                    <!--
                      驿站电话单独一行：原来它挂在 rowOffice 里，营业时间拿不到时整行 GONE，
                      电话也跟着没了 —— 而电话恰恰是"没营业时间"时唯一能联系驿站的手段。
                      这一行可点，点了走系统拨号盘（ACTION_DIAL 不需要 CALL_PHONE 权限）。
                    -->
                    <LinearLayout
                        android:id="@+id/rowPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_phone"
                            app:tint="@color/brand" />

                        <TextView
                            android:id="@+id/tvPhone"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:textColor="@color/brand"
                            android:textSize="13sp"
                            tools:text="驿站电话 0571-88888888 · 点击拨打" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 异常/需要登录提示 -->
            <LinearLayout
                android:id="@+id/boxNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_pill_danger"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvNotice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/danger"
                    android:textSize="14sp"
                    tools:text="登录态已失效，需要重新登录" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNoticeAction"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="36dp"
                    android:text="@string/action_login"
                    android:textSize="13sp"
                    app:backgroundTint="@color/brand"
                    app:cornerRadius="18dp"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!--
              状态筛选 chips：点一下就把列表收窄到某一段，等于给「到站 / 运输中 / 近日签收」
              再加一条定位通道（长列表里翻着找，和点一下就聚焦，体验差很多）。
              件数直接印在 chip 上，所以原来那行「共 50 件（到站 3 · 在途 5 · 签收 42）」
              文字标题就删了 —— 同一份数字不印两遍。
            -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipAll"
                        style="@style/Widget.PickupAssistant.Chip"
                        tools:text="全部 50" />

                    <TextView
                        android:id="@+id/chipArrival"
                        style="@style/Widget.PickupAssistant.Chip"
                        android:layout_marginStart="8dp"
                        tools:text="到站 3" />

                    <TextView
                        android:id="@+id/chipTransit"
                        style="@style/Widget.PickupAssistant.Chip"
                        android:layout_marginStart="8dp"
                        tools:text="运输中 5" />

                    <TextView
                        android:id="@+id/chipDone"
                        style="@style/Widget.PickupAssistant.Chip"
                        android:layout_marginStart="8dp"
                        tools:text="已签收 42" />
                </LinearLayout>
            </HorizontalScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="2"
                tools:listitem="@layout/item_package" />

            <!-- 空态 -->
            <LinearLayout
                android:id="@+id/boxEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:alpha="0.35"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_box"
                    app:tint="@color/text_muted" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/state_empty_title"
                    android:textColor="@color/text_sub"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/state_empty_desc"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 加载中 -->
            <LinearLayout
                android:id="@+id/boxLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="18dp"
                    android:layout_height="18dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/state_loading"
                    android:textColor="@color/text_sub"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
