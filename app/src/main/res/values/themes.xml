<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.CainiaoPickup" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/brand_soft</item>
        <item name="colorOnPrimaryContainer">@color/brand_deep</item>
        <item name="colorSecondary">@color/brand_dark</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorSurfaceVariant">@color/surface_alt</item>
        <item name="colorOnSurfaceVariant">@color/text_sub</item>
        <item name="colorOutline">@color/divider</item>
        <item name="colorError">@color/danger</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorOnBackground">@color/text</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_sub</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Theme.CainiaoPickup.Code" parent="Theme.CainiaoPickup">
        <item name="android:statusBarColor">@color/code_bg</item>
        <item name="android:navigationBarColor">@color/code_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:colorBackground">@color/code_bg</item>
    </style>

    <style name="TextAppearance.Cainiao.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Cainiao.Section" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">@color/text_sub</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!--
      状态筛选 chip：选中/未选中由代码换 background + textColor。
      ⚠ `parent=""` 不能省：样式名里的每个点都是一层**隐式继承**，
      `Widget.Cainiao.Chip` 会去找不存在的 `Widget.Cainiao`，
      AAPT 直接报 `resource style/Widget.Cainiao not found` 整包链接失败。
    -->
    <style name="Widget.Cainiao.Chip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_chip_off</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:textColor">@color/text_sub</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.Cainiao.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
